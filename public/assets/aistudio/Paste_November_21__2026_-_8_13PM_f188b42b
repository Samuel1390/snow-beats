 140:   private fun buildCauseChain(throwable: Throwable): String {
 141:     val parts = mutableListOf<String>()
 142:     var cur: Throwable? = throwable
 143:     var depth = 0
 144:     while (cur != null && depth < 6) {
 145:       val msg = cur.message?.trim()
 146:       if (!msg.isNullOrEmpty() && !parts.contains(msg)) {
 147:         parts.add(msg)
 148:       }
 149:       cur = cur.cause
 150:       depth++
 151:     }
 152:     return if (parts.isEmpty()) throwable.javaClass.simpleName else parts.joinToString(" -> ")
 153:   }
