 982:             if (maybeUpdateYtDlp(context, force = true)) {
 983:               continue
 984:             }
 985:           }
 986:         }
 987:         idx++
 988:       }
 989: 
 990:       if (!succeeded && lastError != null) {
 991:         throw lastError
 992:       }
 993: 
 994:       val downloadedFile = tempDir.listFiles()
 995:         ?.filter { f ->
 996:           f.isFile &&
 997:             !f.name.endsWith(".part") &&
 998:             !f.name.endsWith(".ytdl") &&
 999:             !f.name.endsWith(".temp") &&
1000:             !f.name.endsWith(".jpg") &&
1001:             !f.name.endsWith(".jpeg") &&
1002:             !f.name.endsWith(".webp") &&
1003:             !f.name.endsWith(".png")
1004:         }
1005:         ?.sortedByDescending { it.length() }
1006:         ?.firstOrNull()
1007:         ?: return mapOf(
1008:           "ok" to false,
1009:           "errorCode" to "EMPTY_OUTPUT",
1010:           "errorMessage" to "yt-dlp finalizó pero no generó el archivo de salida."
1011:         )
1012: 
1013:       val exported = exportDownloadedFile(
1014:         context = context,
1015:         sourceFile = downloadedFile,
1016:         mediaType = mediaType,
1017:         targetDisplayPath = targetDisplayPath
1018:       )
1019: 
1020:       if (exported == null) {
1021:         return mapOf(
1022:           "ok" to false,
1023:           "errorCode" to "PERMISSION_DENIED",
1024:           "errorMessage" to "No se pudo guardar el archivo en la carpeta seleccionada. Revisa permisos."
1025:         )
1026:       }
1027: 
1028:       mapOf(
1029:         "ok" to true,
1030:         "filePath" to exported.first,
1031:         "fileName" to exported.second
1032:       )
1033:     } catch (e: Exception) {
1034:       val (code, msg) = classifyError(e, context, detectedPlatform)
1035:       mapOf(
1036:         "ok" to false,
1037:         "errorCode" to code,
1038:         "errorMessage" to msg
1039:       )
1040:     } finally {
1041:       try {
1042:         tempDir.deleteRecursively()
1043:       } catch (_: Exception) { }
1044:     }
