1048:     val ext = fileName.substringAfterLast('.', "").lowercase(Locale.US)
1049:     return when (ext) {
1050:       "mp3" -> "audio/mpeg"
1051:       "m4a" -> "audio/mp4"
1052:       "opus" -> "audio/opus"
1053:       "ogg" -> "audio/ogg"
1054:       "flac" -> "audio/flac"
1055:       "wav" -> "audio/wav"
1056:       "mp4" -> "video/mp4"
1057:       "mkv" -> "video/x-matroska"
1058:       "webm" -> if (mediaType == "audio") "audio/webm" else "video/webm"
1059:       else -> if (mediaType == "audio") "audio/mpeg" else "video/mp4"
1060:     }
