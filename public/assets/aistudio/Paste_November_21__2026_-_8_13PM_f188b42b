1082:         val destDir = resolveTargetDirectory(targetDisplayPath)
1083:         if (destDir.exists() || destDir.mkdirs()) {
1084:           val destFile = resolveUniqueFile(destDir, sourceFile.name)
1085:           FileInputStream(sourceFile).use { input ->
1086:             FileOutputStream(destFile).use { output -> input.copyTo(output) }
1087:           }
1088:           MediaScannerConnection.scanFile(
1089:             context.applicationContext,
1090:             arrayOf(destFile.absolutePath),
1091:             arrayOf(mimeTypeForFile(destFile.name, mediaType)),
1092:             null
1093:           )
1094:           return Pair(destFile.absolutePath, destFile.name)
1095:         }
1096:       } catch (e: Exception) {
1097:         Log.w(TAG, "Fallo escritura directa, intentando SAF/MediaStore: ${e.message}")
1098:       }
1099:     }
1100: 
1101:     // 2. Escritura vía carpeta SAF autorizada (funciona sin bloqueos en HyperOS y Android 11–15)
1102:     val safTreeUri = getPersistedSafTreeUri(context)
1103:     if (safTreeUri != null) {
1104:       val safResult = exportToSafTree(context, safTreeUri, sourceFile, mediaType, targetDisplayPath)
1105:       if (safResult != null) return safResult
1106:     }
1107: 
1108:     // 3. Respaldo oficial vía MediaStore en Android 10+ (nunca requiere MANAGE_EXTERNAL_STORAGE)
1109:     if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
1110:       return exportToMediaStore(context, sourceFile, mediaType)
1111:     }
1112: 
1113:     return null
1114:   }
