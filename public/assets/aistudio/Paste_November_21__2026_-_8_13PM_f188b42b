 888:     if (!hasStorageWritePermission(context)) {
 889:       return mapOf(
 890:         "ok" to false,
 891:         "errorCode" to "PERMISSION_DENIED",
 892:         "errorMessage" to "Permiso de almacenamiento no concedido. Selecciona tu carpeta de descargas para guardar archivos."
 893:       )
 894:     }
 895: 
 896:     if (!isNetworkAvailable(context)) {
 897:       return mapOf(
 898:         "ok" to false,
 899:         "errorCode" to "NO_INTERNET",
 900:         "errorMessage" to "Sin conexión a internet. Conéctate a una red e intenta reanudar."
 901:       )
 902:     }
 903: 
 904:     // Verifica al menos 25 MB libres antes de iniciar
 905:     val freeBytes = getAvailableSpaceBytes(context.cacheDir)
 906:     if (freeBytes < 25L * 1024L * 1024L) {
 907:       return mapOf(
 908:         "ok" to false,
 909:         "errorCode" to "NO_SPACE",
 910:         "errorMessage" to "Espacio insuficiente en el almacenamiento interno. Libera memoria e intenta de nuevo."
 911:       )
 912:     }
 913: 
 914:     val safeTaskDir = taskId.replace(Regex("[^a-zA-Z0-9_-]"), "_")
 915:     val tempDir = File(File(context.cacheDir, "snow_dl_tmp"), safeTaskDir).apply {
 916:       if (exists()) deleteRecursively()
 917:       mkdirs()
 918:     }
 919: 
 920:     return try {
 921:       ensureInitialized(context)
 922: 
 923:       val strategies: List<String?> = if (detectedPlatform == "YouTube") {
 924:         youtubeClientStrategies
 925:       } else {
 926:         listOf(null)
 927:       }
 928: 
 929:       var lastError: Exception? = null
 930:       var didForceUpdate = false
 931:       var succeeded = false
 932: 
 933:       var idx = 0
 934:       while (idx < strategies.size) {
 935:         val extractorArg = strategies[idx]
 936:         // Limpia archivos parciales de un intento fallido previo
 937:         tempDir.listFiles()?.forEach { it.deleteRecursively() }
 938: 
 939:         try {
 940:           val request = YoutubeDLRequest(url).apply {
 941:             addOption("--no-playlist")
 942:             addOption("--no-warnings")
 943:             addOption("--no-check-certificates")
 944:             addOption("--geo-bypass")
 945:             addOption("--retries", "3")
 946:             addOption("--fragment-retries", "3")
 947:             addOption("--newline")
 948:             addOption("--restrict-filenames")
 949:             if (extractorArg != null) {
 950:               addOption("--extractor-args", extractorArg)
 951:             }
 952:             addOption("-o", File(tempDir, "%(title).110B.%(ext)s").absolutePath)
 953: 
 954:             if (mediaType == "audio") {
 955:               addOption("-f", formatId.ifBlank { "bestaudio[ext=m4a]/bestaudio/best" })
 956:               addOption("-x")
 957:               addOption("--audio-format", "mp3")
 958:               addOption("--audio-quality", audioQuality ?: "128K")
 959:               addOption("--embed-thumbnail")
 960:               addOption("--add-metadata")
 961:             } else {
 962:               addOption("-f", formatId.ifBlank { "bestvideo[ext=mp4]+bestaudio[ext=m4a]/best[ext=mp4]/best" })
 963:               addOption("--merge-output-format", "mp4")
 964:             }
 965:           }
 966: 
 967:           YoutubeDL.getInstance().execute(request, taskId) { progress, etaInSeconds, line ->
 968:             onProgress(progress, etaInSeconds, line)
 969:           }
 970:           succeeded = true
 971:           lastError = null
 972:           break
 973:         } catch (e: Exception) {
 974:           lastError = e
 975:           val rawErr = buildCauseChain(e).lowercase(Locale.US)
 976:           Log.w(TAG, "downloadMedia fallo (platform=$detectedPlatform, arg=$extractorArg): $rawErr")
 977:           if (rawErr.contains("canceled") || rawErr.contains("cancelled") || rawErr.contains("destroyed")) {
 978:             throw e
 979:           }
 980:           if (!didForceUpdate && isRetryableExtractorError(e)) {
