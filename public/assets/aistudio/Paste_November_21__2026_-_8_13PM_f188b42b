1116:   private fun resolveUniqueFile(dir: File, originalName: String): File {
1117:     var candidate = File(dir, originalName)
1118:     if (!candidate.exists()) return candidate
1119:     val base = originalName.substringBeforeLast('.', originalName)
1120:     val ext = originalName.substringAfterLast('.', "")
1121:     var index = 1
1122:     while (candidate.exists() && index < 500) {
1123:       val nextName = if (ext.isNotEmpty()) "${base}_($index).$ext" else "${base}_($index)"
1124:       candidate = File(dir, nextName)
1125:       index++
1126:     }
1127:     return candidate
1128:   }
